{
  "name": "orbit-browser-desktop",
  "version": "0.1.4",
  "description": "Orbit Browser for Windows",
  "author": "theDevstars",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thedevstars.orbitbrowser",
    "productName": "Orbit Browser",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/icon.png"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh"
    }
  }
}
